# Google Gemini API Key for Jam Mobile Companion
# Get your API key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: Gemini Model (defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
